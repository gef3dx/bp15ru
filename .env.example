# PRODUCTION EXAMPLE. Do not publish a filled .env or commit it to Git.
# For local preview run: python scripts/setup_local.py
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=your-domain.example,www.your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example,https://www.your-domain.example
# Preserves the original source domain. Set the real canonical domain before launch.
SITE_URL=https://bp15.ru
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=0
# Switch to true only behind a trusted proxy that overwrites X-Forwarded-Proto/X-Real-IP.
DJANGO_TRUST_PROXY_HEADERS=false

DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3
# PostgreSQL: install requirements-production.txt and set DB_ENGINE=postgresql.
# DB_NAME=buro
# DB_USER=buro
# DB_PASSWORD=CHANGE_ME
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=require

# Requests are always stored in the database. Email is an optional notification.
INQUIRY_EMAIL_ENABLED=false
INQUIRY_RECIPIENTS=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
INQUIRY_RATE_LIMIT=10
INQUIRY_RATE_WINDOW_SECONDS=600
