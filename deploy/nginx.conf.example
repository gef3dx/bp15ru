# Replace the domain and certificate paths. Enable DJANGO_TRUST_PROXY_HEADERS=true
# only when the application can be reached exclusively through this proxy.
server {
    listen 80;
    server_name your-domain.example www.your-domain.example;
    return 301 https://your-domain.example$request_uri;
}
server {
    listen 443 ssl;
    server_name your-domain.example www.your-domain.example;
    ssl_certificate /etc/letsencrypt/live/your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example/privkey.pem;
    client_max_body_size 64k;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
